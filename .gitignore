# dependencies are fetched by atlas install, only its config is committed
deps/*
!deps/atlas.config
# generated by nim r build.nim (built and deployed by CI)
docs/*.html
docs/devlog/*.html
docs/deepdive/*.html
# plots made by ggplotnim when the deck and the island 3 deep dive are built
docs/images/penguins*.png
# Shiny apps exported by scripts/shinylive.sh (about 50 MB, exported by the build when missing)
docs/shiny/
# the plant plotted by ggplotnim in the Island 6 deep dive
docs/images/plant*.png
